<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpenseTracker</title>
    <link rel="icon" type="image/x-icon" href="~/favicon1.ico" asp-append-version="true" />
    <meta name="theme-color" content="#eef2f8" />

    @* Pre-paint theme: applied before first render so there is no flash.
       THEME_PREPAINT mirrors the registry in wwwroot/js/themes.js — keep both in sync. *@
    <script>
        (function () {
            var THEME_PREPAINT = {
                daylight: { f: 'light', c: '#eef2f8' },
                midnight: { f: 'dark', c: '#0a101d' },
                parchment: { f: 'light', c: '#f6f1e7' },
                onyx: { f: 'dark', c: '#000000' }
            };
            var LEGACY = { dark: 'midnight', light: 'daylight' };
            var stored = null;
            try { stored = localStorage.getItem('theme'); } catch (e) {}
            var id;
            if (stored && (THEME_PREPAINT[stored] || LEGACY[stored])) {
                id = THEME_PREPAINT[stored] ? stored : LEGACY[stored];
            } else {
                var dark = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches;
                var more = window.matchMedia && matchMedia('(prefers-contrast: more)').matches;
                id = more ? 'onyx' : (dark ? 'midnight' : 'daylight');
            }
            var m = THEME_PREPAINT[id], r = document.documentElement;
            r.setAttribute('data-theme', id);
            r.setAttribute('data-bs-theme', m.f);
            r.classList.add(m.f);
            var mt = document.querySelector('meta[name="theme-color"]');
            if (mt) mt.setAttribute('content', m.c);
        })();
    </script>

    @* Sidebar is collapsed by default; honour a saved expand choice before first paint. *@
    <script>
        try { if (localStorage.getItem('sidebarExpanded') === 'true') document.documentElement.classList.add('sidebar-expanded'); } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseTracker.styles.css" asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
</head>

<body>
    @{
        var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();

        bool IsActive(string controller, params string[] actions)
        {
            if (!string.Equals(currentController, controller.ToLowerInvariant(), StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            return actions.Length == 0 || actions.Any(action => string.Equals(currentAction, action.ToLowerInvariant(),
    StringComparison.OrdinalIgnoreCase));
        }
    }

    <div class="app-container">
        @if (!(ViewData["HideSidebar"] as bool? ?? false))
        {
        <aside id="sidebar">
            <div class="sidebar-logo-area">
                <div class="brand-logo-container">
                    <i data-lucide="wallet" style="width:20px;height:20px"></i>
                </div>
                <span class="brand-name-text">ExpenseTracker</span>
            </div>

            <div class="sidebar-main-content">
                <div class="nav-section">
                    <div class="section-heading">Overview</div>
                    <a asp-controller="Expense" asp-action="Dashboard" class="nav-item-new @(IsActive("Expense", "Dashboard") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="grid"></i></div>
                        <span class="nav-label-text">Dashboard</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="section-heading">Manage</div>
                    <a asp-controller="Category" asp-action="Index" class="nav-item-new @(IsActive("Category") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="tag"></i></div>
                        <span class="nav-label-text">Expense Categories</span>
                    </a>
                    <a asp-controller="Expense" asp-action="Index" class="nav-item-new @(IsActive("Expense", "Index", "Create", "Edit") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="receipt"></i></div>
                        <span class="nav-label-text">Expenses</span>
                    </a>
                    <a asp-controller="Wallet" asp-action="Index" class="nav-item-new @(IsActive("Wallet") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="wallet"></i></div>
                        <span class="nav-label-text">Accounts</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="section-heading">Income</div>
                    <a asp-controller="IncomeCategory" asp-action="Index" class="nav-item-new @(IsActive("IncomeCategory") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="briefcase"></i></div>
                        <span class="nav-label-text">Income Sources</span>
                    </a>
                    <a asp-controller="Income" asp-action="Index" class="nav-item-new @(IsActive("Income") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="trending-up"></i></div>
                        <span class="nav-label-text">Income Log</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="section-heading">Analysis</div>
                    <a asp-controller="Expense" asp-action="MonthlySummary" class="nav-item-new @(IsActive("Expense", "MonthlySummary") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="calendar"></i></div>
                        <span class="nav-label-text">Monthly Summary</span>
                    </a>
                    <a asp-controller="Budget" asp-action="Index" class="nav-item-new @(IsActive("Budget") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="target"></i></div>
                        <span class="nav-label-text">Budget Planning</span>
                    </a>
                    <a asp-controller="Expense" asp-action="Charts" class="nav-item-new @(IsActive("Expense", "Charts") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="line-chart"></i></div>
                        <span class="nav-label-text">Insights</span>
                    </a>
                    <a asp-controller="RecurringTransaction" asp-action="Index" class="nav-item-new @(IsActive("RecurringTransaction") ? "active" : "")">
                        <div class="nav-icon-box"><i data-lucide="refresh-cw"></i></div>
                        <span class="nav-label-text">Automations</span>
                    </a>
                </div>
            </div>
        </aside>
            <button type="button" class="sidebar-edge-toggle" id="sidebarToggle"
                    aria-label="Toggle sidebar" aria-controls="sidebar" aria-expanded="false">
                <i class="chev-right" data-lucide="chevron-right"></i>
                <i class="chev-left" data-lucide="chevron-left"></i>
            </button>
        }

        <div class="main-wrapper">
            <header class="modern-topbar">
                <div class="d-flex align-items-center gap-3">
                    <h2 class="topbar-title">@ViewData["Title"]</h2>
                </div>

                <div class="topbar-actions">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="dropdown profile-menu-wrap">
                            <button type="button" class="topbar-profile-trigger" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="profile-avatar-small">
                                    <i data-lucide="user" size="18"></i>
                                </div>
                                <i data-lucide="chevron-down" size="14" class="profile-chevron"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile">
                                <li class="profile-menu-header">
                                    <div class="profile-menu-avatar">
                                        <i data-lucide="user" size="18"></i>
                                    </div>
                                    <div style="min-width:0">
                                        <p class="profile-menu-name">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</p>
                                        <p class="profile-menu-email">@(User.Identity?.Name ?? "")</p>
                                    </div>
                                </li>
                                <li>
                                    <a asp-controller="Profile" asp-action="Index" class="dropdown-item-custom">
                                        <i data-lucide="user-round" size="18"></i>
                                        Profile
                                    </a>
                                </li>
                                <li class="profile-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item-custom text-danger" data-bs-toggle="modal"
                                            data-bs-target="#logoutModal">
                                        <i data-lucide="log-out" size="18"></i>
                                        Sign Out
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-primary rounded-pill px-4 fw-bold">Login</a>
                    }
                </div>
            </header>

            <!-- Modern Logout Confirmation Modal -->
            <div class="modal fade glass-modal" id="logoutModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content modern-modal-content">
                        <div class="modal-body p-4 p-md-5 text-center">
                            <div class="logout-icon-wrapper mb-4">
                                <div class="logout-icon-bg pulse-danger">
                                    <i data-lucide="log-out" style="width: 28px; height: 28px; color: var(--t-danger-ink)"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-main mb-2">Sign Out?</h4>
                            <p class="text-muted mb-4 fs-14">
                                You are about to sign out of your account. Any unsaved progress may be lost. Are you sure you want to proceed?
                            </p>
                            <div class="d-flex flex-column flex-sm-row gap-3">
                                <button type="button" class="btn btn-modern-cancel flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-grow-1 d-flex m-0">
                                    <button type="submit" class="btn btn-modern-danger flex-grow-1">Sign Out</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <main class="content-container">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 ExpenseTracker &mdash; Built by <strong>Afroz</strong></span>
                <span style="opacity:.4">&middot;</span>
                <a href="@Url.Action("Privacy", "Home")">Privacy Policy</a>
            </footer>
        </div>
    </div>

    @if (!(ViewData["HideMobileQuickAction"] as bool? ?? false))
    {
        <button type="button" class="mobile-floating-btn d-lg-none" id="mobileFloatingBtn" aria-label="Open navigation">
            <i data-lucide="grid-2x2"></i>
        </button>
    }

    <div class="offcanvas offcanvas-bottom mobile-nav-sheet" tabindex="-1" id="mobileNavSheet"
         aria-labelledby="mobileNavSheetLabel">
        <div class="sheet-drag-handle-wrapper" id="sheetDragHandle">
            <div class="sheet-drag-handle"></div>
        </div>
        <div class="offcanvas-header mobile-nav-sheet-header" style="padding-top: 6px;">
            <div>
                <p class="mobile-nav-sheet-kicker mb-1">Quick access</p>
                <h5 class="mobile-nav-sheet-title mb-0" id="mobileNavSheetLabel">Navigate faster</h5>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body mobile-nav-sheet-body">
            <div class="mobile-nav-sheet-grid">
                <a href="@Url.Action("Dashboard", "Expense")"
                   class="mobile-sheet-link @(IsActive("Expense", "Dashboard") ? "active" : "")">
                    <i data-lucide="grid"></i>
                    <span>Dashboard</span>
                </a>
                <a href="@Url.Action("Index", "Category")"
                   class="mobile-sheet-link @(IsActive("Category", "Index") ? "active" : "")">
                    <i data-lucide="tag"></i>
                    <span>Expense Categories</span>
                </a>
                <a href="@Url.Action("Index", "Expense")"
                   class="mobile-sheet-link @(IsActive("Expense", "Index") ? "active" : "")">
                    <i data-lucide="receipt"></i>
                    <span>Expenses</span>
                </a>
                <a href="@Url.Action("Index", "Wallet")"
                   class="mobile-sheet-link @(IsActive("Wallet", "Index") ? "active" : "")">
                    <i data-lucide="wallet"></i>
                    <span>Accounts</span>
                </a>
                <a href="@Url.Action("Index", "IncomeCategory")"
                   class="mobile-sheet-link @(IsActive("IncomeCategory", "Index") ? "active" : "")">
                    <i data-lucide="briefcase"></i>
                    <span>Income Sources</span>
                </a>
                <a href="@Url.Action("Index", "Income")"
                   class="mobile-sheet-link @(IsActive("Income", "Index") ? "active" : "")">
                    <i data-lucide="trending-up"></i>
                    <span>Income Log</span>
                </a>
                <a href="@Url.Action("MonthlySummary", "Expense")"
                   class="mobile-sheet-link @(IsActive("Expense", "MonthlySummary") ? "active" : "")">
                    <i data-lucide="calendar"></i>
                    <span>Monthly Summary</span>
                </a>
                <a href="@Url.Action("Index", "Budget")"
                   class="mobile-sheet-link @(IsActive("Budget", "Index") ? "active" : "")">
                    <i data-lucide="target"></i>
                    <span>Budget Planning</span>
                </a>
                <a href="@Url.Action("Charts", "Expense")"
                   class="mobile-sheet-link @(IsActive("Expense", "Charts") ? "active" : "")">
                    <i data-lucide="line-chart"></i>
                    <span>Insights</span>
                </a>
                <a href="@Url.Action("Index", "RecurringTransaction")"
                   class="mobile-sheet-link @(IsActive("RecurringTransaction", "Index") ? "active" : "")">
                    <i data-lucide="refresh-cw"></i>
                    <span>Automations</span>
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/themes.js" asp-append-version="true"></script>

    <!-- Global Toast System -->
    <script>
        $(function () {
        @if (TempData.Peek("SuccessMessage") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString())), "success");</text>
        }
        @if (TempData.Peek("Success") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())), "success");</text>
        }
        @if (TempData.Peek("RegistrationSuccess") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["RegistrationSuccess"]?.ToString())), "success");</text>
        }
        @if (TempData.Peek("ErrorMessage") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString())), "error");</text>
        }
        @if (TempData.Peek("Error") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())), "error");</text>
        }
        @if (TempData.Peek("DeleteMessage") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["DeleteMessage"]?.ToString())), "delete");</text>
        }
        @if (TempData.Peek("Delete") != null)
        {
            <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Delete"]?.ToString())), "delete");</text>
        }
        });
    </script>

    @RenderSection("Scripts", required: false)

    <script>
        $(function () {
            lucide.createIcons();

            // --- Sidebar collapse toggle (button-driven, not hover) ---
            const root = document.documentElement;
            const sidebarToggle = document.getElementById('sidebarToggle');
            if (sidebarToggle) {
                const sync = () => sidebarToggle.setAttribute('aria-expanded', String(root.classList.contains('sidebar-expanded')));
                sync();
                sidebarToggle.addEventListener('click', function () {
                    const expanded = !root.classList.contains('sidebar-expanded');
                    root.classList.toggle('sidebar-expanded', expanded);
                    try { localStorage.setItem('sidebarExpanded', String(expanded)); } catch (e) {}
                    sync();
                });
            }

            // --- Draggable Floating Action Button ---
            const $btn = $('#mobileFloatingBtn');
            const offcanvasEl = document.getElementById('mobileNavSheet');

            if ($btn.length && offcanvasEl) {
                let isDragging = false, startX, startY, initialLeft, initialTop, hasDragged = false;
                $btn.css('touch-action', 'none');

                const dragStart = (e) => {
                    const clientX = e.clientX || (e.touches && e.touches[0].clientX);
                    const clientY = e.clientY || (e.touches && e.touches[0].clientY);
                    if (clientX === undefined || clientY === undefined) return;
                    isDragging = true; hasDragged = false;
                    startX = clientX; startY = clientY;
                    const rect = $btn[0].getBoundingClientRect();
                    initialLeft = rect.left; initialTop = rect.top;
                    $btn.css({ left: initialLeft + 'px', top: initialTop + 'px', right: 'auto', bottom: 'auto', transition: 'none' });
                    $(document).on('mousemove touchmove', dragMove);
                    $(document).on('mouseup touchend', dragEnd);
                };
                const dragMove = (e) => {
                    if (!isDragging) return;
                    const clientX = e.clientX || (e.touches && e.touches[0].clientX);
                    const clientY = e.clientY || (e.touches && e.touches[0].clientY);
                    if (clientX === undefined || clientY === undefined) return;
                    const dx = clientX - startX, dy = clientY - startY;
                    if (Math.hypot(dx, dy) > 5) hasDragged = true;
                    const margin = 10, btnWidth = $btn.outerWidth(), btnHeight = $btn.outerHeight();
                    const maxLeft = window.innerWidth - btnWidth - margin;
                    const maxTop = window.innerHeight - btnHeight - margin;
                    $btn.css({ left: Math.max(margin, Math.min(initialLeft + dx, maxLeft)) + 'px',
                               top: Math.max(margin, Math.min(initialTop + dy, maxTop)) + 'px' });
                };
                const dragEnd = () => {
                    isDragging = false;
                    $(document).off('mousemove touchmove', dragMove);
                    $(document).off('mouseup touchend', dragEnd);
                };
                $btn.on('mousedown touchstart', dragStart);
                $btn.on('click', function (e) {
                    if (hasDragged) { e.preventDefault(); e.stopPropagation(); return; }
                    if (window.bootstrap && window.bootstrap.Offcanvas) {
                        window.bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl)?.toggle();
                    }
                });
            }

            // --- Resizable Offcanvas Sheet ---
            const $sheet = $('#mobileNavSheet');
            const $handle = $('#sheetDragHandle');
            if ($sheet.length && $handle.length) {
                let isResizing = false, startY, startHeight;
                const resizeStart = (e) => {
                    const clientY = e.clientY || (e.touches && e.touches[0].clientY);
                    if (clientY === undefined) return;
                    isResizing = true; startY = clientY; startHeight = $sheet.outerHeight();
                    $sheet.css({ transition: 'none', height: startHeight + 'px', 'max-height': '95vh' });
                    $(document).on('mousemove touchmove', resizeMove);
                    $(document).on('mouseup touchend', resizeEnd);
                };
                const resizeMove = (e) => {
                    if (!isResizing) return;
                    const clientY = e.clientY || (e.touches && e.touches[0].clientY);
                    if (clientY === undefined) return;
                    const newHeight = startHeight + (startY - clientY);
                    const finalHeight = Math.max(180, Math.min(newHeight, window.innerHeight * 0.95));
                    $sheet.css({ height: finalHeight + 'px', 'max-height': finalHeight + 'px' });
                };
                const resizeEnd = () => {
                    isResizing = false;
                    $sheet.css({ transition: '' });
                    $(document).off('mousemove touchmove', resizeMove);
                    $(document).off('mouseup touchend', resizeEnd);
                };
                $handle.on('mousedown touchstart', resizeStart);
                if (offcanvasEl) {
                    offcanvasEl.addEventListener('hidden.bs.offcanvas', function () {
                        $sheet.css({ height: '', 'max-height': '' });
                    });
                }
            }
        });
    </script>
</body>

</html>
